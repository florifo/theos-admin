# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# Clave pública (publishable / anon). El código acepta ambos nombres.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio (secret / service_role) — solo server-side, nunca exponer al cliente.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Solo para migraciones / scripts locales
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=

# Contraseña para los usuarios de prueba creados por scripts/seed-test-users.ts.
# Nunca se hardcodea en el código; definila acá (local) o como variable de entorno.
SEED_TEST_PASSWORD=

# Brevo (envío real de email). API key SOLO acá, nunca en la BD.
BREVO_API_KEY=
# Límite diario de envíos (300 del free tier menos margen de seguridad)
BREVO_DAILY_LIMIT=280

# Cron de la cola de emails (edge function process-email-queue)
CRON_SECRET=
NEXT_PUBLIC_SITE_URL=https://admin.theosplace.org

# ── Health checks de crons (opcional pero recomendado) ─────────────────────
# URLs de ping de Healthchecks.io (o Cronitor): cada cron hace GET al terminar
# OK; si el ping no llega en la ventana esperada, el servicio alerta por correo.
# Crear un check por cron en https://healthchecks.io (free tier alcanza).
#
# LA LISTA COMPLETA — una por cron de vercel.json. Sin la variable, el cron
# corre igual: el ping es no-op. El horario es el de vercel.json (UTC).
HEALTHCHECK_URL_GROUP_WINDOWS=        # group-enrollment-windows  · 12:30 diario
HEALTHCHECK_URL_FOLLETO_BLOCKS=       # folleto-blocks            · 13:00 diario
HEALTHCHECK_URL_START_REMINDERS=      # studies/start-reminders   · 13:30 diario
HEALTHCHECK_URL_LEADER_ABSENCE=       # leader-absence-check      · 14:00 diario
HEALTHCHECK_URL_STORAGE_ORPHANS=      # storage-orphans           · 15:00 lunes
HEALTHCHECK_URL_PAYMENT_HOLDS_EXPIRE= # payment-holds-expire      · 16:00 diario
HEALTHCHECK_URL_PAYMENT_REMINDERS=    # payment-reminders         · 16:30 lunes
HEALTHCHECK_URL_EVENT_SURVEYS=        # event-surveys             · 17:00 diario
HEALTHCHECK_URL_REPORT_SNAPSHOTS=     # report-snapshots          · 06:00 diario
HEALTHCHECK_URL_BIRTHDAYS=            # birthday-greetings       · 12:00 diario
HEALTHCHECK_URL_CLOSE_REMINDERS=      # close-reminders          · 14:30 diario
HEALTHCHECK_URL_STUDY_SURVEYS=        # study-surveys             · 17:30 diario
HEALTHCHECK_URL_SCHEDULED_BROADCASTS= # scheduled-broadcasts      · cada 15 min
HEALTHCHECK_URL_STUDY_REQUESTS_EXPIRE= # study-requests-expire   · 1° feb/jun/oct

# ── Sentry (opcional) ──────────────────────────────────────────────────────
# Sin DSN, Sentry es no-op. Crear proyecto en sentry.io (free tier) y pegar:
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Tutoriales grabados (scripts/tutoriales): usuario del seed [prueba] — ver /ayuda/datos-de-prueba
TUTORIAL_USER_EMAIL=
TUTORIAL_USER_PASSWORD=

# ── Modo silencioso de correos (MIG-1 Etapa 0) ─────────────────────────────
# Con esto en 1, el sistema NO le manda correos a nadie: registra en
# silenced_emails lo que habría enviado (destinatario + asunto) y sigue de largo.
# El guard está en sendEmail(), por donde pasa TODO.
#
# ÚNICA excepción: los correos de acceso (definir/restablecer contraseña,
# reenviar activación), marcados con authCritical en su call site. Sin ellos el
# staff no puede entrar.
#
# Se usa mientras los datos son pruebas de procesos. Antes de apagarlo:
#   npx tsx scripts/reporte-correos-silenciados.ts
# Si la lista no está limpia, no se apaga. Vacío o 0 = el sistema envía normal.
EMAIL_SILENT_MODE=

# Orígenes que pueden meter el CALENDARIO en un iframe (separados por coma).
# Solo aplica a /calendario; el resto del sistema no se puede embeber.
# Vacío = nadie fuera de este dominio, que es el comportamiento por defecto.
EMBED_ALLOWED_ORIGINS=https://www.theosplace.org,https://theosplace.org
